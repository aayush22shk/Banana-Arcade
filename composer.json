{
    "name": "banana/arcade-api",
    "description": "Banana Arcade Game - University Enterprise PHP REST API & SPA Application",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Enterprise Software Engineering Student",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.0",
        "ext-pdo": "*",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "api/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "C:\\xampp\\php\\php.exe tests/run_tests.php"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}

